# Optional – die Werte stehen schon in src/public-config.ts (gleiches Supabase-Projekt
# wie die KickTime-App). Umgebungsvariablen haben Vorrang, falls gesetzt.
VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key
VITE_VAPID_PUBLIC_KEY=

# Geheimnisse (ADMIN_PIN, VAPID_PRIVATE_KEY, CRON_SECRET, service_role) gehören
# NIE hierher, sondern nur in die Supabase-Secrets.
